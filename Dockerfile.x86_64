# vLLM x86_64 + sm_120 (RTX 5060 Ti / GB206 Blackwell)
# Adapted from AEON-7/vllm-ultimate-dgx-spark (ARM64/sm_121a DGX Spark)
# by EnricoFerrero64 — branch feat/x86_64-sm120
#
# Changes vs upstream Dockerfile:
#   - Base: nvcr.io/nvidia/cuda:13.0.3-devel-ubuntu22.04 (x86_64 instead of ARM64 AEON base)
#   - TORCH_CUDA_ARCH_LIST=12.0 (sm_120 instead of 12.1a)
#   - CUDA lib path: x86_64-linux (instead of sbsa-linux)
#   - vLLM source cloned from lesj0610/vllm inside Docker (pinned commit)
#   - PyTorch 2.11.0+cu130 installed from official whl index
#   - flashinfer 0.6.12 from flashinfer.ai whl (falls back to source build)
#   - Multi-stage build: builder (devel, not pushed) + runtime (~15 GB final image)
#
# LAYER STRUCTURE — read before editing:
#
#   ┌─ STAGE 1: builder (NOT pushed to GHCR) ───────────────────────────────────┐
#   │  STABLE (changing = full 2h rebuild):                                     │
#   │  1. apt + python3.12 + pip                                                │
#   │  2. libnvrtc.so symlink                                                   │
#   │  3. torch==2.11.0+cu130                                                   │
#   │  4. git clone vllm @e4a9fbee (pinned)                                     │
#   │  5. pip install . ← THE EXPENSIVE LAYER (~2h CUDA compilation)           │
#   │  MUTABLE (editing = minutes, not hours):                                  │
#   │  6. pip dep fixes: setuptools + torch re-pin + cuda-python                │
#   │  7. flashinfer                                                             │
#   │  8. modelopt                                                               │
#   │  9. patches (COPY + apply)                                                │
#   │ 10. scipy + turboquant                                                    │
#   │ 11. transformers (most likely to update)                                  │
#   │ 12. humming-stub                                                           │
#   │ 13. verify + smoke test                                                   │
#   └────────────────────────────────────────────────────────────────────────────┘
#   ┌─ STAGE 2: runtime (~15-18 GB — this is what gets pushed to GHCR) ─────────┐
#   │  - cuda:13.0.3-runtime base (no nvcc, no headers, no static libs)        │
#   │  - Python 3.12 + CUDA runtime math libs (apt)                            │
#   │  - NCCL runtime (copied from builder)                                     │
#   │  - site-packages + executables (copied from builder)                      │
#   └────────────────────────────────────────────────────────────────────────────┘
#
# NVFP4 KV cache on sm_120:
#   - Triton path (PR #44389): works with CAUSAL speculators (mtp/eagle3/ngram)
#   - FlashInfer NVFP4 path: requires SM100 (B100/B200) — NOT available on sm_120
#   - DFlash speculator: must use --kv-cache-dtype auto (BF16), not nvfp4
#   - AEON Qwen3.6-27B-MTP-XS uses MTP → --kv-cache-dtype nvfp4 is enabled

# ══════════════════════════════════════════════════════════════════════════════
# STAGE 1: builder — full devel environment for CUDA compilation
# This stage is large (~40 GB) but is NOT pushed as the final image.
# ══════════════════════════════════════════════════════════════════════════════
FROM nvcr.io/nvidia/cuda:13.0.3-devel-ubuntu22.04 AS builder

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV TORCH_CUDA_ARCH_LIST="12.0"
ENV ENABLE_NVFP4_SM100=0
ENV CCACHE_DISABLE=1
ENV CMAKE_BUILD_PARALLEL_LEVEL=6
ENV MAX_JOBS=6
ENV NVCC_THREADS=2
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV SETUPTOOLS_SCM_PRETEND_VERSION="0.23.0+aeon.x86.sm120"
ENV SETUPTOOLS_SCM_PRETEND_VERSION_FOR_VLLM="0.23.0+aeon.x86.sm120"

WORKDIR /build

# ── STABLE LAYER 1: system deps ──────────────────────────────────────────────
# Python 3.12 via deadsnakes PPA + CUDA 13.0 dev headers.
# DO NOT add pip packages here — any change invalidates the entire build.
RUN apt-get update && \
    apt-get install -y --no-install-recommends software-properties-common && \
    add-apt-repository -y ppa:deadsnakes/ppa && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        python3.12 python3.12-dev python3.12-venv \
        python3-pip \
        git ca-certificates curl \
        cuda-nvrtc-dev-13-0 \
        libcusparse-dev-13-0 \
        libcublas-dev-13-0 \
        libcusolver-dev-13-0 \
        libcufft-dev-13-0 \
        libcurand-dev-13-0 \
        libnvjitlink-dev-13-0 && \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1 && \
    update-alternatives --install /usr/bin/python python /usr/bin/python3.12 1 && \
    curl -sS https://bootstrap.pypa.io/get-pip.py | python3.12 && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# ── STABLE LAYER 2: libnvrtc.so symlink ──────────────────────────────────────
RUN CUDA_LIB=/usr/local/cuda-13.0/targets/x86_64-linux/lib && \
    if [ ! -f "$CUDA_LIB/libnvrtc.so" ] && ls "$CUDA_LIB/libnvrtc.so.13"* &>/dev/null; then \
        ln -sf "$(ls $CUDA_LIB/libnvrtc.so.13* | head -1)" "$CUDA_LIB/libnvrtc.so"; \
        echo "Created libnvrtc.so symlink"; \
    fi && \
    ls -la "$CUDA_LIB/libnvrtc.so"* 2>/dev/null || echo "[libnvrtc] no symlink needed"

# ── STABLE LAYER 3: PyTorch ───────────────────────────────────────────────────
# Must be installed before vLLM build (CMake locates torch headers via the package).
RUN pip3 install --no-cache-dir \
    "torch==2.11.0+cu130" \
    --index-url https://download.pytorch.org/whl/cu130 && \
    python3 -c "import torch; print('torch:', torch.__version__, '| cuda:', torch.version.cuda)"

# ── STABLE LAYER 4: clone vLLM source ────────────────────────────────────────
# Pinned to exact commit — safe from upstream branch rewrites.
# PRs merged: #44389 (Triton NVFP4 KV), #40898, #41703, #43982 (DFlash fixes)
RUN git clone --filter=blob:none \
      --branch lesj/triton-nvfp4-kv-fork-20260602 \
      https://github.com/lesj0610/vllm.git \
      /build/vllm-src && \
    cd /build/vllm-src && \
    git checkout e4a9fbee08b14a49470cfcf6a87dd0b2bddb6345 && \
    echo "[vllm-src] checked out: $(git log --oneline -1)"

# ── STABLE LAYER 5: compile vLLM (~2h) ───────────────────────────────────────
# setuptools 70.x ships with Python 3.12 and is sufficient to BUILD vLLM
# (the >=77 requirement is a pip metadata declaration, not enforced at compile time).
# We fix it in the mutable layer below so this cache is never invalidated by that.
WORKDIR /build/vllm-src
RUN pip3 install -v . 2>&1 | tee /tmp/vllm-install.log | tail -120 && \
    echo "[vllm pip install] exit=$?"

# ═════════════════════════════════════════════════════════════════════════════
# MUTABLE LAYERS — edit freely; only invalidates from here down (minutes)
# ═════════════════════════════════════════════════════════════════════════════

# ── MUTABLE LAYER 6: pip dep fixes ───────────────────────────────────────────
# - setuptools: pip metadata says >=77.0.3; upgrade now that the build is done
# - torch re-pin: vLLM deps may have pulled a different cu1xx build; force cu130
# - cuda-python: vLLM pulls cuda-python 13.3.1 which conflicts with cu130
#   cuda-bindings 13.0.3; pin to 13.0.x series to silence the resolver warning
RUN pip3 install --no-cache-dir "setuptools>=77.0.3,<81" && \
    pip3 install --no-cache-dir --force-reinstall \
        "torch==2.11.0+cu130" \
        --index-url https://download.pytorch.org/whl/cu130 && \
    python3 -c "import torch; assert '2.11.0' in torch.__version__, \
        f'wrong torch: {torch.__version__}'; print('torch pinned:', torch.__version__)" && \
    pip3 install --no-cache-dir \
        "cuda-python~=13.0.0" \
        "cuda-bindings~=13.0.0" \
        2>&1 | tail -3 || \
    echo "[WARN] cuda-python 13.0.x pin unavailable — resolver conflict is cosmetic only"

# ── MUTABLE LAYER 7: flashinfer ───────────────────────────────────────────────
# Try pre-built wheels: cu130 → cu128 (binary-compatible) → source build (~20 min).
RUN pip3 install --no-cache-dir "flashinfer==0.6.12" \
      --extra-index-url https://flashinfer.ai/whl/cu130/torch2.11/ \
      2>&1 | tail -3 && echo "[flashinfer] cu130 pre-built OK" || \
    (pip3 install --no-cache-dir "flashinfer==0.6.12" \
       --extra-index-url https://flashinfer.ai/whl/cu128/torch2.11/ \
       2>&1 | tail -3 && echo "[flashinfer] cu128 pre-built OK") || \
    (echo "[flashinfer] building from source for sm_120 (~20 min)..." && \
     TORCH_CUDA_ARCH_LIST="12.0" pip3 install --no-cache-dir \
       "git+https://github.com/flashinfer-ai/flashinfer.git@v0.6.12" \
       2>&1 | tail -20 && echo "[flashinfer] source build OK") && \
    python3 -c "import flashinfer; print('flashinfer:', flashinfer.__version__)"

# ── MUTABLE LAYER 8: modelopt ─────────────────────────────────────────────────
RUN pip3 install --no-cache-dir "nvidia-modelopt>=0.23.0" 2>&1 | tail -3 || \
    echo "[WARN] modelopt unavailable — NVFP4 weight loading may fail at runtime"

# ── MUTABLE LAYER 9: AEON + sm_120 patches ───────────────────────────────────
COPY patches/ /aeon-patches/
RUN cd /aeon-patches && \
    echo "=== patch 1: cuda_optional_import ===" && python3 patch_cuda_optional_import.py && \
    echo "=== patch 2: kv_cache_utils ===" && python3 patch_kv_cache_utils.py && \
    echo "=== patch 3: cudagraph_align ===" && python3 patch_cudagraph_align.py && \
    echo "=== patch 4: sm_120 triton launch config ===" && python3 patch_sm120_triton_launch.py && \
    echo "[patches] all applied"

# ── MUTABLE LAYER 10: scipy + turboquant ─────────────────────────────────────
RUN pip3 install --no-cache-dir "scipy>=1.11" 2>&1 | tail -3 && \
    pip3 install --no-cache-dir --no-deps \
      "turboquant @ git+https://github.com/AEON-7/turboquant.git@058fe891f20baee3b6ac8976049bdf31b1270edf" \
      2>&1 | tail -3 || \
    echo "[WARN] turboquant unavailable — QJL speculative decoding not supported"

# ── MUTABLE LAYER 11: transformers ───────────────────────────────────────────
# Qwen3.6 multimodal needs 5.10+; pinned to a specific commit (no @main drift).
RUN pip3 install --no-cache-dir --upgrade \
      "transformers @ git+https://github.com/huggingface/transformers.git@c2fafabbebd83cd6062c809ab602bbeafab639b9" \
      2>&1 | tail -3 && \
    python3 -c "import transformers; print('transformers:', transformers.__version__)"

# ── MUTABLE LAYER 12: humming-stub ───────────────────────────────────────────
# vLLM eagerly imports from NVIDIA-internal `humming` quant lib at init time.
# Without this stub, vLLM fails to load even on models that don't use humming.
COPY humming-stub/ /tmp/humming-stub/
RUN pip3 install --no-cache-dir /tmp/humming-stub && rm -rf /tmp/humming-stub && \
    python3 -c "from humming.dtypes import DataType; print('humming-stub: importable')"

# ── MUTABLE LAYER 13: verify + smoke test ────────────────────────────────────
COPY verify.py /tmp/verify.py
RUN python3 /tmp/verify.py && rm /tmp/verify.py
RUN python3 -c "\
from vllm import LLM, SamplingParams; \
from vllm.config import VllmConfig; \
print('Build complete — sm_120 x86_64 ready')"

# ── MUTABLE LAYER 14: slim ───────────────────────────────────────────────────
# NO strip on .so files — pre-built wheels (torch, numpy, scipy, modelopt) use
# non-standard ELF layouts that strip --strip-unneeded can corrupt (proven with
# OpenBLAS: "ELF load command address/offset not page-aligned").
#
# Safe removals only — none of these are needed at runtime:
# torch/include/: C++ headers for extension compilation (done in builder stage)
# torch/test/:    PyTorch test suite (~400 MB)
# *.pyi:          IDE type stubs (~100 MB)
# __pycache__:    Regenerated on first import
RUN rm -rf \
        /usr/local/lib/python3.12/dist-packages/torch/include/ \
        /usr/local/lib/python3.12/dist-packages/torch/test/ && \
    find /usr/local/lib/python3.12/ -name "*.pyi" -delete 2>/dev/null || true && \
    find /usr/local/lib/python3.12/ -type d -name "__pycache__" \
        -exec rm -rf {} + 2>/dev/null || true && \
    echo "[slim] done — removed build-only artifacts (no .so stripping)"

# ══════════════════════════════════════════════════════════════════════════════
# STAGE 2: runtime — lean image pushed to GHCR (~15-18 GB vs ~40 GB)
#
# Strips: nvcc, CUDA headers, static libs, vLLM source tree, build artifacts.
# Keeps:  Python 3.12, pip packages (vllm, torch, flashinfer, …), CUDA runtime.
# ══════════════════════════════════════════════════════════════════════════════
FROM nvcr.io/nvidia/cuda:13.0.3-runtime-ubuntu22.04

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV SETUPTOOLS_SCM_PRETEND_VERSION="0.23.0+aeon.x86.sm120"
ENV SETUPTOOLS_SCM_PRETEND_VERSION_FOR_VLLM="0.23.0+aeon.x86.sm120"
# Cache dirs — mount these as volumes to survive container restarts:
#   /root/.triton        → Triton JIT kernel cache (saves 2-5 min cold start)
#   /root/.cache/torch   → torch.compile + CUDA extension cache
ENV TRITON_CACHE_DIR=/root/.triton

# Python 3.12 + CUDA runtime math libs needed by PyTorch/Triton/vLLM at runtime.
# build-essential      →                    (Triton CudaUtils JIT: gcc + libc6-dev/stdlib.h needed to compile cuda_utils.c at startup)
# python3.12-dev       →                    (Triton CudaUtils JIT: Python.h needed — cuda_utils.c is a Python C extension)
# cuda-nvrtc-13-0      → libnvrtc.so        (Triton JIT kernel compilation)
# libcublas-13-0       → libcublas.so       (PyTorch matmul, attention)
# libcusparse-13-0     → libcusparse.so     (sparse ops)
# libcusolver-13-0     → libcusolver.so     (linear algebra)
# libcufft-13-0        → libcufft.so        (FFT ops)
# libcurand-13-0       → libcurand.so       (random sampling)
# libnvjitlink-13-0    → libnvjitlink.so    (PTX JIT linking for Triton)
RUN apt-get update && \
    apt-get install -y --no-install-recommends software-properties-common && \
    add-apt-repository -y ppa:deadsnakes/ppa && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        python3.12 python3.12-dev \
        ca-certificates curl \
        build-essential \
        cuda-nvrtc-13-0 \
        libcublas-13-0 \
        libcusparse-13-0 \
        libcusolver-13-0 \
        libcufft-13-0 \
        libcurand-13-0 \
        libnvjitlink-13-0 && \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1 && \
    update-alternatives --install /usr/bin/python python /usr/bin/python3.12 1 && \
    curl -sS https://bootstrap.pypa.io/get-pip.py | python3.12 && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# NCCL runtime — needed for TP=2 tensor-parallel over PCIe.
# Copied from builder to avoid needing the NVIDIA ML apt repo.
COPY --from=builder /usr/lib/x86_64-linux-gnu/libnccl.so* /usr/lib/x86_64-linux-gnu/

# libnvrtc.so versionless symlink — Triton JIT expects it without version suffix.
RUN CUDA_LIB=/usr/local/cuda-13.0/targets/x86_64-linux/lib && \
    if [ ! -f "$CUDA_LIB/libnvrtc.so" ] && ls "$CUDA_LIB/libnvrtc.so.13"* &>/dev/null; then \
        ln -sf "$(ls $CUDA_LIB/libnvrtc.so.13* | head -1)" "$CUDA_LIB/libnvrtc.so"; \
    fi

# Copy all pip-installed packages and console scripts from builder.
# /usr/local/lib/python3.12/ contains vllm, torch, flashinfer, modelopt, …
# /usr/local/bin/ contains pip, uvicorn, vllm CLI, and other entry points.
COPY --from=builder /usr/local/lib/python3.12/ /usr/local/lib/python3.12/
COPY --from=builder /usr/local/bin/ /usr/local/bin/

# Refresh shared library cache after NCCL copy.
RUN ldconfig

# Smoke-test: verify Triton CudaUtils can compile at build time.
# cuda_utils.c is a Python C extension that includes cuda.h + Python.h.
# Compiling it here (without linking libcuda.so.1) catches missing headers
# before the image is pushed — no GPU needed, fails in seconds not minutes.
RUN TRITON_INC=/usr/local/lib/python3.12/dist-packages/triton/backends/nvidia/include && \
    PY_INC=$(python3.12 -c "import sysconfig; print(sysconfig.get_path('include'))") && \
    printf '#include "cuda.h"\n#include <Python.h>\n#include <stdlib.h>\nint x = 0;\n' > /tmp/triton_test.c && \
    gcc -c /tmp/triton_test.c -I"$TRITON_INC" -I"$PY_INC" -o /tmp/triton_test.o && \
    rm /tmp/triton_test.c /tmp/triton_test.o && \
    echo "[smoke-test] Triton CudaUtils headers OK"

EXPOSE 8000
ENTRYPOINT ["/bin/bash"]
